[TEMPLATE]
# Copy to .env and fill in values. Never commit .env.
# Placeholder values only — do NOT put real API keys in this file.

# Retrieval provider: tavily | serper | empty
# If unset, auto-selects Tavily when TAVILY_API_KEY is set, else Serper, else empty.
RETRIEVAL_PROVIDER=tavily

# Web search APIs (set one to enable live retrieval)
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# LLM provider (used in later steps — explainer / evidence)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Rate limiting (lightweight, in-memory)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# CORS: comma-separated allowed origins, or * for any origin
CORS_ORIGINS=*

# App settings
LOG_LEVEL=INFO
