# Copy to .env and fill in values. Never commit .env.

# Retrieval provider: tavily | serper | empty
# If unset, auto-selects Tavily when TAVILY_API_KEY is set, else Serper, else empty.
RETRIEVAL_PROVIDER=

# Web search APIs (set one to enable live retrieval)
TAVILY_API_KEY=
SERPER_API_KEY=

# LLM provider (used in later steps — explainer / evidence)
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# App settings
LOG_LEVEL=INFO
